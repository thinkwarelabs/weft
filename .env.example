# Weft — copy to .env and fill in. NEVER commit .env.
#
# This platform must NOT store client credentials, .env values, or API keys on
# behalf of clients. It may link to where a secret lives; it must never hold it.
# Secrets management is a separate, dedicated system.

# --- Database (Supabase Postgres) ------------------------------------------
# Runtime: transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: session-mode pooler (port 5432). DDL cannot run through the
# transaction pooler.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# --- Internal auth (Google Workspace SSO) ----------------------------------
AUTH_SECRET=""                 # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Internal access is configured by exactly ONE of the next two vars.
# See src/lib/auth/identity.ts — the rule is pure and unit-tested.
#
# WORKSPACE MODE: set this to your Google Workspace domain. Access then requires
# a verified `hd` claim on Google's ID token. Leave EMPTY until you actually
# have a Workspace — consumer Gmail accounts carry no `hd` claim, so a non-empty
# value here locks everyone out.
WORKSPACE_DOMAIN=""

# ALLOWLIST MODE: used when WORKSPACE_DOMAIN is empty. Server-side, checked in
# the signIn callback before a session is issued. Setting WORKSPACE_DOMAIN later
# closes the door on these addresses — the modes are exclusive by design.
INTERNAL_EMAILS="shivxmsharma@gmail.com,sarthak.ai002@gmail.com,tamannasachdeva27@gmail.com"

# Narrower capability: who may read the audit trail. Comma-separated.
AUDIT_ADMINS="shivxmsharma@gmail.com"

# --- Client trust boundary --------------------------------------------------
# Signs the scoped feedback cookie. MUST differ from AUTH_SECRET — boot fails
# if they match. openssl rand -base64 32
CLIENT_TOKEN_SECRET=""
# Public origin, used to build feedback links.
APP_URL="http://localhost:3000"

# --- Email ------------------------------------------------------------------
# Resend delivers client feedback links.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Weft <noreply@thinkwarelabs.com>"
# SMTP is used for the internal "invoice finalized" notification (ported from
# the Invoice app). Optional — if unset, finalization still works silently.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""
EMAIL_TO=""
EMAIL_CC=""

# --- Google Drive (Vault, Step 6) -------------------------------------------
# The single owner whose Drive stores all uploads. Never a service account —
# service accounts have no consumer storage quota and uploads would fail.
DRIVE_OWNER_EMAIL=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/drive/callback"
# 32-byte base64 key for AES-256-GCM encryption of the stored refresh token.
DRIVE_TOKEN_ENCRYPTION_KEY=""

# --- Voice notes (Step 6) ---------------------------------------------------
# Without it, voice notes still record; only transcription is disabled.
OPENAI_API_KEY=""

# --- Ops --------------------------------------------------------------------
# Shared secret for the public keep-alive endpoint (GET /api/health?key=…),
# which stops a free-tier Supabase project from pausing.
HEALTHCHECK_KEY=""
